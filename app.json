{
  "expo": {
    "name": "Shono",
    "slug": "BudPilot",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "budpilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.wahidalways.budpilot",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#2C5DC9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F4F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-ble-manager",
        {
          "neverForLocation": true,
          "isBleRequired": true
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Shono: native code looked up by name at runtime (Bluetooth, blur, SVG, Shono's own module, Expo modules)\n-keep class it.innove.** { *; }\n-keep class eightbitlab.com.blurview.** { *; }\n-keep class com.horcrux.svg.** { *; }\n-keep class expo.modules.** { *; }\n-dontwarn eightbitlab.com.blurview.**"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
