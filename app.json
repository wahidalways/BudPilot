{
  "expo": {
    "name": "Shono",
    "slug": "BudPilot",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "budpilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.wahidalways.budpilot",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#2C5DC9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF0F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#08090B",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/sora/600SemiBold/Sora_600SemiBold.ttf"
          ]
        }
      ],
      [
        "react-native-ble-manager",
        {
          "neverForLocation": true,
          "isBleRequired": true
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Shono: native code looked up by name at runtime (Bluetooth, blur, SVG, Shono's own module, Expo modules)\n-keep class it.innove.** { *; }\n-keep class eightbitlab.com.blurview.** { *; }\n-keep class com.horcrux.svg.** { *; }\n-keep class expo.modules.** { *; }\n-dontwarn eightbitlab.com.blurview.**",
            "useLegacyPackaging": true
          }
        }
      ],
      "./plugins/no-gif"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
