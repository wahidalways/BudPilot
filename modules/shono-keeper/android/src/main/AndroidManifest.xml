<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- staying connected to the earbuds in the background, with an ongoing notification -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- "Run without limits": Android's own question about battery optimisation (App settings, or offered once) -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- App settings › Check for updates: Shono installs its own new release (Android asks the person first) -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Game mode › Turn on with games: which app is in front (Usage access, which the user allows in Android's settings) -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <!-- and whether it's a game: apps you can open from the launcher (Android 11+ hides others from Shono) -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
  <!-- Find my earbuds › Last seen (off until the user turns it on): the phone's location when the earbuds disconnect -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

  <application>
    <service
      android:name="expo.modules.shonokeeper.KeeperService"
      android:exported="false"
      android:foregroundServiceType="connectedDevice|location" />
  </application>
</manifest>
